# Local demo credentials — replace with strong values before sharing.
TECHACADEMY_OWNER_PASSWORD=replace-with-a-strong-owner-password
TECHACADEMY_LEARNER_PASSWORD=replace-with-a-strong-learner-password

# Optional conversational LLM (Groq). Without these variables, the contextual local assistant is used.
ENABLE_LLM_ASSISTANT=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
